# Copy to .env and adjust as needed.
# SQLite database (path is relative to prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# OPTIONAL: forward support/contact tickets to an external webhook (JSON POST).
# Leave unset to run in honest "unconfigured" mode (form validates, nothing is sent).
# SUPPORT_WEBHOOK_URL="https://example.com/hook"
